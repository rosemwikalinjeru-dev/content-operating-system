# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase "publishable" key (or legacy anon key). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app, used for the magic-link redirect.
SITE_URL=http://localhost:3000
# Comma-separated emails allowed to sign in. Empty = nobody can sign in.
OWNER_EMAILS=
LOG_LEVEL=info
# Trigger.dev production secret key (Trigger.dev → API keys → Production, starts with tr_prod_).
# Lets the web app start background jobs. Server-side only.
TRIGGER_SECRET_KEY=
