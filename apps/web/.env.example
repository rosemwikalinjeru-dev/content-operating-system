# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase "publishable" key (or legacy anon key). Safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public URL of this app, used for the magic-link redirect.
SITE_URL=http://localhost:3000
# Comma-separated emails allowed to sign in. Empty = nobody can sign in.
OWNER_EMAILS=
LOG_LEVEL=info
# Background jobs run inside this app by default (JOB_RUNNER=inline), so it needs the worker
# secrets below. Server-side only: never prefix them with NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → secret key. Bypasses RLS: used only by job code.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Optional: set to "trigger" to run jobs on Trigger.dev instead (needs TRIGGER_SECRET_KEY).
JOB_RUNNER=inline
TRIGGER_SECRET_KEY=
# Phase 2 research. ScrapeCreators → dashboard → API key (1 credit per request). Server-side only.
SCRAPECREATORS_API_KEY=
# Any long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
