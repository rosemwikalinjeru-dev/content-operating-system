# Background job secrets. In production set these in Trigger.dev → Environment Variables
# (Production), never in Vercel, GitHub or this repository.
SUPABASE_URL=https://your-project.supabase.co
# Supabase → Project Settings → API Keys → secret / service_role key. Bypasses RLS: workers only.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Only needed locally for `pnpm dev` / deploys; CI reads it from a GitHub secret.
TRIGGER_PROJECT_REF=
